# Copier ce fichier en .env si tu veux changer les valeurs par défaut.
# Aucun identifiant n'est nécessaire : OpenF1 est public pour les données historiques.

# Base locale (SQLite). Le chemin est relatif à la racine du projet.
DATABASE_URL=sqlite:///data/f1.db

# Saison et circuits chargés (noms "circuit_short_name" d'OpenF1, séparés par des virgules)
F1_SEASON=2025
F1_CIRCUITS=Sakhir,Catalunya,Hungaroring,Monza

# Hypothèse de correction carburant
FUEL_START_KG=100
FUEL_SEC_PER_KG=0.03
